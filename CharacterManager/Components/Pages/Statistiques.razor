@page "/statistiques"
@using CharacterManager.Server.Constants
@using CharacterManager.Server.Services
@using CharacterManager.Server.Models
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>Statistiques</PageTitle>

<link rel="stylesheet" href="/css/Statistiques.css" />
<div class="container-fluid py-4">
    <div class="page-header-banner">
        <h1 class="page-title">
            <i class="bi bi-bar-chart-fill"></i>
            <LocalizedText Key="statistics.title" />
        </h1>
    </div>

    <div class="statistiques-container">
        @if (mercenaires == null)
        {
            <div class="loading-container">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">
                        <LocalizedText Key="common.loading" />
                    </span>
                </div>
                <p>
                    <LocalizedText Key="statistics.loading" />
                </p>
            </div>
        }
        else if (!mercenaires.Any())
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>
                    <LocalizedText Key="statistics.noData" />
                </p>
            </div>
        }
        else
        {
            <div class="stats-grid">
                <!-- Graphique par Type d'Attaque -->
                <div class="stat-card">
                    <div class="stat-card-header">
                        <i class="bi bi-crosshair"></i>
                        <h2>
                            <LocalizedText Key="statistics.chartTitleAttackType" />
                        </h2>
                    </div>
                    <div class="stat-card-body">
                        <canvas id="chartTypeAttaque"></canvas>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-summary">
                            @foreach (var stat in statsTypeAttaque)
                            {
                                <div class="stat-item">
                                    <span class="stat-label">@GetTypeAttaqueLabel(stat.Key):</span>
                                    <span class="stat-value">@stat.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Graphique par Faction -->
                <div class="stat-card">
                    <div class="stat-card-header">
                        <i class="bi bi-flag-fill"></i>
                        <h2>
                            <LocalizedText Key="statistics.chartTitleFaction" />
                        </h2>
                    </div>
                    <div class="stat-card-body">
                        <canvas id="chartFaction"></canvas>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-summary">
                            @foreach (var stat in statsFaction)
                            {
                                <div class="stat-item">
                                    <span class="stat-label">@GetFactionLabel(stat.Key):</span>
                                    <span class="stat-value">@stat.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Graphique par Rang -->
                <div class="stat-card">
                    <div class="stat-card-header">
                        <i class="bi bi-star-fill"></i>
                        <h2>
                            <LocalizedText Key="statistics.chartTitleRank" />
                        </h2>
                    </div>
                    <div class="stat-card-body">
                        <canvas id="chartRang"></canvas>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-summary">
                            @foreach (var stat in statsRang.OrderByDescending(s => s.Key))
                            {
                                <div class="stat-item">
                                    <span class="stat-label">
                                        <LocalizedText Key="statistics.rankLabel" /> @stat.Key:
                                    </span>
                                    <span class="stat-value">@stat.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Graphique Evolution des Niveaux -->
                <div class="stat-card">
                    <div class="stat-card-header">
                        <i class="bi bi-graph-up"></i>
                        <h2>
                            <LocalizedText Key="statistics.chartTitleLevelEvolution" />
                        </h2>
                    </div>
                    <div class="stat-card-body">
                        <canvas id="chartLevelEvolution"></canvas>
                    </div>
                </div>
            </div>

            <!-- Statistiques additionnelles -->
            <div class="additional-stats">
                <div class="stat-box">
                    <i class="bi bi-people-fill"></i>
                    <div class="stat-box-content">
                        <h3 style="font-size: 1.4em; margin-bottom: 0.8rem; color: #667eea;">
                            <strong><LocalizedText Key="statistics.mercenaires" /></strong>
                        </h3>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0.4rem;"><strong>Total:</strong> @GetTotalMercenaires()</p>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0.4rem;"><strong>
                            <LocalizedText Key="statistics.mostPowerful" /> : @GetMaxPower() (@GetMostPowerfulName())
                        </strong></p>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0;"><strong>
                            <LocalizedText Key="statistics.leastPowerful" /> : @GetMinPower() (@GetLeastPowerfulName())
                        </strong></p>
                    </div>
                </div>
                <div class="stat-box">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <div class="stat-box-content">
                        <h3 style="font-size: 1.4em; margin-bottom: 0.8rem; color: #667eea;">
                            <strong><LocalizedText Key="statistics.power" /></strong>
                        </h3>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0.4rem;"><strong>Moyenne:</strong> @GetAveragePower()</p>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0.4rem;"><strong>
                            <LocalizedText Key="statistics.mostPowerful" /> : @GetMaxPower() (@GetMostPowerfulName())
                        </strong></p>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0;"><strong>
                            <LocalizedText Key="statistics.leastPowerful" /> : @GetMinPower() (@GetLeastPowerfulName())
                        </strong></p>
                    </div>
                </div>
                <div class="stat-box">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <div class="stat-box-content">
                        <h3 style="font-size: 1.4em; margin-bottom: 0.8rem; color: #667eea;">
                            <strong><LocalizedText Key="statistics.level" /></strong>
                        </h3>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0.4rem;"><strong>Moyenne:</strong> @GetAverageLevel()</p>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0.4rem;"><strong>
                            <LocalizedText Key="statistics.highestLevel" /> : @GetMaxLevel() (@GetHighestLevelName())
                        </strong></p>
                        <p class="stat-box-value" style="font-size: 0.95em; margin-bottom: 0;"><strong>
                            <LocalizedText Key="statistics.lowestLevel" /> : @GetMinLevel() (@GetLowestLevelName())
                        </strong></p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Inject]
    public PersonnageService PersonnageService { get; set; } = null!;

    [Inject]
    public ClientLocalizationService LocalizationService { get; set; } = null!;

    private IEnumerable<Personnage>? mercenaires;
    private Dictionary<TypeAttaque, int> statsTypeAttaque = new();
    private Dictionary<Faction, int> statsFaction = new();
    private Dictionary<int, int> statsRang = new();

    // Méthodes helper pour les statistiques mercenaires
    private int GetTotalMercenaires() => mercenaires?.Count() ?? 0;
    
    // Méthodes helper pour les statistiques de puissance
    private int GetAveragePower() => mercenaires?.Any() == true ? (int)mercenaires.Average(m => m.Puissance) : 0;
    private int GetMaxPower() => mercenaires?.Any() == true ? mercenaires.Max(m => m.Puissance) : 0;
    private int GetMinPower() => mercenaires?.Any() == true ? mercenaires.Min(m => m.Puissance) : 0;
    private string GetMostPowerfulName() => mercenaires?.Any() == true ? mercenaires.OrderByDescending(m => m.Puissance).First().Nom : "N/A";
    private string GetLeastPowerfulName() => mercenaires?.Any() == true ? mercenaires.OrderBy(m => m.Puissance).First().Nom : "N/A";

    // Méthodes helper pour les statistiques de niveau
    private int GetAverageLevel() => mercenaires?.Any() == true ? (int)mercenaires.Average(m => m.Niveau) : 0;
    private int GetMaxLevel() => mercenaires?.Any() == true ? mercenaires.Max(m => m.Niveau) : 0;
    private int GetMinLevel() => mercenaires?.Any() == true ? mercenaires.Min(m => m.Niveau) : 0;
    private string GetHighestLevelName() => mercenaires?.Any() == true ? mercenaires.OrderByDescending(m => m.Niveau).First().Nom : "N/A";
    private string GetLowestLevelName() => mercenaires?.Any() == true ? mercenaires.OrderBy(m => m.Niveau).First().Nom : "N/A";
}
