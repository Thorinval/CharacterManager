@page "/maison-lucie"
@using CharacterManager.Components.Layout
@using CharacterManager.Server.Services
@using CharacterManager.Server.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@rendermode InteractiveServer

@inject PersonnageService PersonnageService
@inject NavigationManager NavigationManager

<link rel="stylesheet" href="/css/MaisonLucie.css" />

<div class="lucie-house-container">
    <div class="lucie-house-header">
        <div class="lucie-house-title-section">
            <i class="bi bi-house-fill lucie-icon"></i>
            <h1><LocalizedText Key="navigation.lucieHouse" /></h1>
        </div>
        
        @if (lucieHouse != null)
        {
            <div class="d-flex align-items-center gap-3">
                <div class="affection-badge" role="button" tabindex="0" title="Modifier l'affection" @onclick="StartAffectionEdit">
                    <i class="bi bi-heart-fill"></i>
                    <span class="affection-value">@lucieHouse.Affection</span>
                    <span class="affection-label">Affection</span>
                </div>

                <div class="lucie-house-actions d-flex align-items-center gap-2">
                    <button class="btn btn-success" @onclick="ExportLucieHouse" title="Exporter Lucie House">
                        <i class="bi bi-download"></i> Exporter
                    </button>
                    <label class="btn btn-info mb-0" for="lucieImportFile" title="Importer une sauvegarde Lucie House">
                        <i class="bi bi-upload"></i> Importer
                    </label>
                    <InputFile id="lucieImportFile" class="d-none" accept=".pml,.xml" OnChange="HandleLucieImport" />
                </div>
            </div>

            @if (editingAffection)
            {
                <div class="affection-editor">
                    <div class="affection-editor-row">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-heart-fill"></i></span>
                            <InputNumber @bind-Value="affectionDraft" class="form-control" min="0" step="1" />
                        </div>
                        <div class="affection-editor-actions">
                            <button class="btn btn-primary" @onclick="SaveAffectionAsync" disabled="@savingAffection">
                                @if (savingAffection)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                <span class="ms-1">Enregistrer</span>
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CancelAffectionEdit" disabled="@savingAffection">Annuler</button>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(affectionError))
                    {
                        <div class="text-danger small mt-1">@affectionError</div>
                    }
                </div>
            }
        }
    </div>

    @if (lucieHouse == null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p><LocalizedText Key="loading" /></p>
        </div>
    }
    else if (pieces.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p><LocalizedText Key="noData" /></p>
        </div>
    }
    else
    {
        <div class="pieces-grid hub-grid">
            @foreach (var piece in pieces.OrderByDescending(p => p.Puissance).ToList())
            {
                var isEditing = editingPieceId == piece.Id;
                <div class="piece-card hub-card @(isEditing ? "editing" : "")">
                    <div class="piece-header hub-card-head">
                        <h3 class="piece-name" title="@piece.Nom">@piece.Nom</h3>
                        @if (isEditing)
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success" @onclick="() => SavePieceEdit(piece)" disabled="@savingPiece">
                                    <i class="bi bi-check"></i>
                                </button>
                                <button class="btn btn-sm btn-secondary" @onclick="CancelPieceEdit">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <span class="piece-level">Lvl @piece.Niveau</span>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartPieceEdit(piece)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="piece-body">
                        @if (isEditing)
                        {
                            <!-- Mode édition -->
                            <div class="edit-mode">
                                <div class="mb-2">
                                    <label class="form-label">Niveau</label>
                                    <InputNumber @bind-Value="pieceEditDraft.Niveau" class="form-control form-control-sm" min="1" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-check-label">
                                        <InputCheckbox @bind-Value="pieceEditDraft.Selectionnee" class="form-check-input" />
                                        Sélectionnée
                                    </label>
                                </div>
                                @if (pieceEditDraft.AspectsTactiques != null)
                                {
                                    <div class="mb-2">
                                        <label class="form-label">Puissance Tactique</label>
                                        <InputNumber @bind-Value="pieceEditDraft.AspectsTactiques.Puissance" class="form-control form-control-sm" min="0" />
                                    </div>
                                }
                                @if (pieceEditDraft.AspectsStrategiques != null)
                                {
                                    <div class="mb-2">
                                        <label class="form-label">Puissance Stratégique</label>
                                        <InputNumber @bind-Value="pieceEditDraft.AspectsStrategiques.Puissance" class="form-control form-control-sm" min="0" />
                                    </div>
                                }
                                <div class="stat-row mt-2">
                                    <span class="stat-label">Puissance totale:</span>
                                    <span class="stat-value">@pieceEditDraft.Puissance</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Mode lecture -->
                            <!-- Puissance Totale -->
                            <div class="stat-row">
                                <span class="stat-label">Puissance</span>
                                <span class="stat-value">@piece.Puissance</span>
                            </div>
                        }

                        <!-- Aspect Tactique -->
                        @if (piece.AspectsTactiques != null && !isEditing)
                        {
                            <div class="aspect-section">
                                <div class="aspect-header">
                                    <i class="bi bi-lightning-fill"></i>
                                    <span>Tactique</span>
                                </div>
                                <div class="aspect-content">
                                    <div class="aspect-puissance">
                                        <span class="label">Puissance:</span>
                                        <span class="value">@piece.AspectsTactiques.Puissance</span>
                                    </div>
                                    @if (piece.AspectsTactiques.Bonus?.Count > 0)
                                    {
                                        <div class="aspect-bonus">
                                            <span class="label">Bonus:</span>
                                            <div class="bonus-list">
                                                @foreach (var bonus in piece.AspectsTactiques.Bonus)
                                                {
                                                    <span class="bonus-tag">@bonus</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Aspect Stratégie -->
                        @if (piece.AspectsStrategiques != null && !isEditing)
                        {
                            <div class="aspect-section">
                                <div class="aspect-header">
                                    <i class="bi bi-shield-fill"></i>
                                    <span>Stratégique</span>
                                </div>
                                <div class="aspect-content">
                                    <div class="aspect-puissance">
                                        <span class="label">Puissance:</span>
                                        <span class="value">@piece.AspectsStrategiques.Puissance</span>
                                    </div>
                                    @if (piece.AspectsStrategiques.Bonus?.Count > 0)
                                    {
                                        <div class="aspect-bonus">
                                            <span class="label">Bonus:</span>
                                            <div class="bonus-list">
                                                @foreach (var bonus in piece.AspectsStrategiques.Bonus)
                                                {
                                                    <span class="bonus-tag">@bonus</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Bonus Totaux -->
                        @if (!isEditing)
                        {
                            <div class="bonus-totals">
                                <div class="bonus-row">
                                    <span class="bonus-label">Total Tactique:</span>
                                    <span class="bonus-value">@(piece.BonusTactiques?.Count ?? 0)</span>
                                </div>
                                <div class="bonus-row">
                                    <span class="bonus-label">Total Stratégique:</span>
                                    <span class="bonus-value">@(piece.BonusStrategiques?.Count ?? 0)</span>
                                </div>
                            </div>
                        }

                        <!-- Sélection -->
                        @if (!isEditing)
                        {
                            <div class="selection-indicator">
                                @if (piece.Selectionnee)
                                {
                                    <span class="selected-badge"><i class="bi bi-check-circle-fill"></i> Sélectionnée</span>
                                }
                                else
                                {
                                    <span class="not-selected-badge"><i class="bi bi-circle"></i> Non sélectionnée</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Statistiques Globales -->
        <div class="statistics-section">
            <h2><LocalizedText Key="statistics" /></h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-title">Total Pièces</span>
                    <span class="stat-number">@pieces.Count</span>
                </div>
                <div class="stat-card">
                    <span class="stat-title">Pièces Sélectionnées</span>
                    <span class="stat-number">@pieces.Count(p => p.Selectionnee)</span>
                </div>
                <div class="stat-card">
                    <span class="stat-title">Puissance Max Tactique</span>
                    <span class="stat-number">@pieces.Max(p => p.AspectsTactiques?.Puissance ?? 0)</span>
                </div>
                <div class="stat-card">
                    <span class="stat-title">Puissance Max Stratégique</span>
                    <span class="stat-number">@pieces.Max(p => p.AspectsStrategiques?.Puissance ?? 0)</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Server.Models.LucieHouse? lucieHouse;
    private List<Server.Models.Piece> pieces = new();
    private bool lucieImporting;
    private bool lucieExporting;
    private bool editingAffection;
    private int affectionDraft;
    private bool savingAffection;
    private string? affectionError;
    
    private int? editingPieceId;
    private Server.Models.Piece pieceEditDraft = new();
    private bool savingPiece;

    [Inject]
    public PmlImportService PmlImportService { get; set; } = null!;

    [Inject]
    public PmlExportService PmlExportService { get; set; } = null!;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadLucieHouseDataAsync();
    }

    private async Task LoadLucieHouseDataAsync()
    {
        try
        {
            lucieHouse = await PersonnageService.GetLucieHouseAsync();

            if (lucieHouse != null)
            {
                // Récupérer les pièces avec leurs aspects
                pieces = await PersonnageService.GetLuciePiecesAsync();
                affectionDraft = lucieHouse.Affection;
            }
            else
            {
                pieces = new();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erreur lors du chargement de la Lucie House: {ex.Message}");
        }
    }

    private async Task ExportLucieHouse()
    {
        if (lucieExporting)
            return;

        lucieExporting = true;

        try
        {
            // Réutilise l'export existant (Lucie House incluse dans l'export inventaire)
            var payload = await PmlExportService.ExporterInventairePmlAsync(Enumerable.Empty<Personnage>());
            var fileName = $"LucieHouse_{DateTime.Now:yyyyMMdd_HHmmss}.pml";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(payload));
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur export Lucie House: {ex.Message}");
        }
        finally
        {
            lucieExporting = false;
        }
    }

    private async Task HandleLucieImport(InputFileChangeEventArgs e)
    {
        if (lucieImporting)
            return;

        lucieImporting = true;

        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await PmlImportService.ImportPmlAsync(
                stream,
                file.Name,
                importInventory: true,
                importTemplates: false,
                importBestSquad: false,
                importHistories: false,
                importLeagueHistory: false);

            if (result.IsSuccess)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Import Lucie House réussi ({result.SuccessCount} éléments)");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Error ?? "Import Lucie House échoué");
            }

            await LoadLucieHouseDataAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur import Lucie House: {ex.Message}");
        }
        finally
        {
            lucieImporting = false;
        }
    }

    private void StartAffectionEdit()
    {
        if (lucieHouse == null)
        {
            return;
        }

        affectionDraft = lucieHouse.Affection;
        affectionError = null;
        editingAffection = true;
    }

    private void CancelAffectionEdit()
    {
        editingAffection = false;
        affectionError = null;
    }

    private async Task SaveAffectionAsync()
    {
        if (lucieHouse == null || savingAffection)
        {
            return;
        }

        savingAffection = true;
        affectionError = null;

        try
        {
            var updatedValue = await PersonnageService.UpdateLucieAffectionAsync(affectionDraft);
            // Rafraîchir depuis la source pour éviter tout décalage d'état
            await LoadLucieHouseDataAsync();
            if (lucieHouse != null)
            {
                lucieHouse.Affection = updatedValue;
                affectionDraft = updatedValue;
            }

            editingAffection = false;
        }
        catch (Exception ex)
        {
            affectionError = $"Erreur lors de la mise à jour : {ex.Message}";
        }
        finally
        {
            savingAffection = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartPieceEdit(Server.Models.Piece piece)
    {
        editingPieceId = piece.Id;
        // Créer une copie pour l'édition
        pieceEditDraft = new Server.Models.Piece
        {
            Id = piece.Id,
            Nom = piece.Nom,
            Niveau = piece.Niveau,
            Selectionnee = piece.Selectionnee,
            AspectsTactiques = piece.AspectsTactiques != null ? new Aspect 
            { 
                Nom = piece.AspectsTactiques.Nom,
                Puissance = piece.AspectsTactiques.Puissance,
                Bonus = new List<string>(piece.AspectsTactiques.Bonus)
            } : new Aspect { Nom = "Aspects tactiques", Puissance = 0 },
            AspectsStrategiques = piece.AspectsStrategiques != null ? new Aspect 
            { 
                Nom = piece.AspectsStrategiques.Nom,
                Puissance = piece.AspectsStrategiques.Puissance,
                Bonus = new List<string>(piece.AspectsStrategiques.Bonus)
            } : new Aspect { Nom = "Aspects stratégiques", Puissance = 0 }
        };
    }

    private void CancelPieceEdit()
    {
        editingPieceId = null;
    }

    private async Task SavePieceEdit(Server.Models.Piece originalPiece)
    {
        if (savingPiece) return;

        savingPiece = true;
        try
        {
            // Mettre à jour la pièce via le service
            await PersonnageService.UpdateLuciePieceAsync(pieceEditDraft);
            
            // Mettre à jour l'objet local
            originalPiece.Niveau = pieceEditDraft.Niveau;
            originalPiece.Selectionnee = pieceEditDraft.Selectionnee;
            if (originalPiece.AspectsTactiques != null && pieceEditDraft.AspectsTactiques != null)
            {
                originalPiece.AspectsTactiques.Puissance = pieceEditDraft.AspectsTactiques.Puissance;
            }
            if (originalPiece.AspectsStrategiques != null && pieceEditDraft.AspectsStrategiques != null)
            {
                originalPiece.AspectsStrategiques.Puissance = pieceEditDraft.AspectsStrategiques.Puissance;
            }

            editingPieceId = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur lors de la mise à jour: {ex.Message}");
        }
        finally
        {
            savingPiece = false;
        }
    }
}
