@page "/historique-modifications"
@using CharacterManager.Server.Models
@using CharacterManager.Server.Services
@using Microsoft.AspNetCore.Components.Forms
@inject HistoriqueModificationService HistoriqueService
@inject IJSRuntime JSRuntime

<PageTitle>Historique des modifications</PageTitle>

<link rel="stylesheet" href="/css/HistoriqueModifications.css" />
<script src="/js/historique.js"></script>

<div class="container-fluid py-4">
    <!-- Toast d'import en cours -->
    @if (isImporting)
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11; width: 100%; max-width: 400px;">
            <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header bg-primary text-white">
                    <i class="bi bi-hourglass-split me-2"></i>
                    <strong class="me-auto">Import en cours...</strong>
                </div>
                <div class="toast-body">
                    <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                    </div>
                    <div class="mt-2 small text-muted">
                        Veuillez patienter pendant le traitement de votre fichier...
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="page-header-banner">
        <h1><i class="bi bi-clock-history"></i> Historique des modifications</h1>
    </div>

    <!-- Import / Prévisualisation -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-upload text-primary"></i>
                <strong>Import de l'historique (JSON)</strong>
            </div>
            @if (importComplete)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetImport">Réinitialiser</button>
            }
        </div>
        <div class="card-body">
            @if (!previewComplete && !importComplete)
            {
                <EditForm Model="@this" OnValidSubmit="HandlePreview">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Fichier historique (.json)</label>
                            <InputFile class="form-control" OnChange="OnFileSelected" accept=".json" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success" disabled="@(importBytes == null || isImporting)">
                                @if (isImporting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Prévisualiser
                            </button>
                        </div>
                    </div>
                </EditForm>
            }

            @if (previewComplete && !isImporting)
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Pré-rapport :</strong> @(previewResult?.ValidCount ?? 0) entrée(s) prête(s) à être importée(s).
                        @if (previewResult?.DuplicateCount > 0)
                        {
                            <span class="text-info ms-2">(@previewResult.DuplicateCount doublon(s) ignoré(s))</span>
                        }
                        @if (!string.IsNullOrEmpty(previewResult?.Error))
                        {
                            <span class="text-danger ms-2">@previewResult.Error</span>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (HasConflicts)
                        {
                            <button class="btn btn-warning" @onclick="() => showConflictResolver = true">Résoudre les conflits (@ConflictsUnresolved / @ConflictsTotal)</button>
                        }
                        <button class="btn btn-success" disabled="@(!CanApplyImport)" @onclick="ApplyImport">Appliquer l'import</button>
                        <button class="btn btn-secondary" @onclick="ResetImport">Annuler</button>
                    </div>
                </div>

                @if (previewResult?.Logs.Any() == true)
                {
                    <div class="border rounded p-3 bg-light mb-3">
                        <h6 class="mb-2">Rapport détaillé</h6>
                        
                        @* Grouper par niveau (OK, Warning, Error, Duplicate) *@
                        @foreach (var levelGroup in previewResult.Logs.GroupBy(l => l.Level).OrderBy(g => g.Key))
                        {
                            var levelId = $"level_{levelGroup.Key}";
                            var levelCount = levelGroup.Count();
                            var levelBadgeClass = GetLevelBadgeClass(levelGroup.Key);
                            var levelLabel = GetLevelLabel(levelGroup.Key);
                            var isLevelExpanded = expandedCollapseSections.Contains(levelId);
                            
                            <div class="card mb-2">
                                <div class="card-header p-2" style="cursor: pointer;" @onclick="() => ToggleCollapse(levelId)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge @levelBadgeClass">@levelLabel</span>
                                            <span class="ms-2">@levelCount entrée(s)</span>
                                        </div>
                                        <i class="bi bi-chevron-@(isLevelExpanded ? "up" : "down")"></i>
                                    </div>
                                </div>
                                @if (isLevelExpanded)
                                {
                                    <div class="card-body p-2">
                                        @* Grouper par catégorie *@
                                        @foreach (var categoryGroup in levelGroup.GroupBy(l => l.Category).OrderBy(g => g.Key.ToString()))
                                        {
                                            <div class="mb-2">
                                                <div class="fw-bold text-uppercase small text-muted">@categoryGroup.Key</div>
                                                
                                                @* Grouper par type de données (Création, Modification, Suppression) *@
                                                @foreach (var dataGroup in categoryGroup.GroupBy(l => l.DataType).OrderBy(g => g.Key))
                                                {
                                                    var dataId = $"{levelId}_{categoryGroup.Key}_{dataGroup.Key}".Replace(" ", "_");
                                                    var dataCount = dataGroup.Count();
                                                    var isDataExpanded = expandedCollapseSections.Contains(dataId);
                                                    
                                                    <div class="ms-3 mb-2">
                                                        <div class="border-start border-3 ps-2" style="cursor: pointer;" @onclick="() => ToggleCollapse(dataId)">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="fw-semibold">@dataGroup.Key</span>
                                                                    <span class="badge bg-secondary rounded-pill ms-2">@dataCount</span>
                                                                </div>
                                                                <i class="bi bi-chevron-@(isDataExpanded ? "down" : "right")"></i>
                                                            </div>
                                                        </div>
                                                        @if (isDataExpanded)
                                                        {
                                                            <ul class="list-unstyled ms-4 mt-2 mb-2">
                                                                @foreach (var log in dataGroup)
                                                                {
                                                                    <li class="d-flex align-items-start gap-2 mb-1">
                                                                        <i class="bi bi-dot"></i>
                                                                        <span class="small">@log.Message</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (showConflictResolver && HasConflicts)
                {
                    <div class="card mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>Résolution des conflits (@ConflictsUnresolved non résolus / @ConflictsResolved résolus)</div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-success" @onclick="() => ResolveAllConflicts(true)">Tout ignorer</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ResolveAllConflicts(false)">Ne rien importer</button>
                            </div>
                        </div>
                        <div class="card-body" style="max-height: 320px; overflow:auto;">
                            @foreach (var conflict in previewResult!.Conflicts)
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <div class="fw-semibold">@conflict.PersonnageName (@conflict.ChampModifie) - @conflict.DateClassement</div>
                                    <div class="text-muted small">Ancienne: @conflict.AncienneValeur | Nouvelle: @conflict.NouvelleValeur</div>
                                    <div class="mt-1 d-flex gap-3">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="@($"c_{conflict.ConflictKey}")" value="skip" checked="@(IsConflictResolved(conflict.ConflictKey, true))" @onchange="_ => SetConflictDecision(conflict.ConflictKey, true)">
                                            <label class="form-check-label">Ignorer cette entrée</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="@($"c_{conflict.ConflictKey}")" value="block" checked="@(IsConflictResolved(conflict.ConflictKey, false))" @onchange="_ => SetConflictDecision(conflict.ConflictKey, false)">
                                            <label class="form-check-label">Bloquer l'import</label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <button class="btn btn-secondary" @onclick="() => showConflictResolver = false">Annuler</button>
                            <button class="btn btn-primary" disabled="@(ConflictsUnresolved > 0)" @onclick="() => showConflictResolver = false">OK</button>
                        </div>
                    </div>
                }
            }

            @if (importComplete && !isImporting && importResult != null)
            {
                <div class="alert @(importResult.IsSuccess ? "alert-success" : "alert-danger")">
                    <strong>@(importResult.IsSuccess ? "Import réussi" : "Import en échec")</strong>
                    <div>@importResult.SuccessCount entrée(s) traitée(s)</div>
                    @if (importResult.DuplicateCount > 0)
                    {
                        <div class="text-info">@importResult.DuplicateCount doublon(s) ignoré(s)</div>
                    }
                    @if (!string.IsNullOrEmpty(importResult.Error))
                    {
                        <div class="text-danger">@importResult.Error</div>
                    }
                </div>

                @if (importResult.ConflictsApplied.Any())
                {
                    <div class="border rounded p-3 bg-light mb-3">
                        <h6 class="mb-2">Conflits résolus</h6>
                        @foreach (var c in importResult.ConflictsApplied)
                        {
                            <div class="small">@c.PersonnageName / @c.ChampModifie / @c.DateClassement : @(c.Overwritten ? "Ignoré" : "Bloqué")</div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Type d'entité</label>
                    <select class="form-select" @bind="filtreTypeEntite">
                        <option value="">Tous</option>
                        <option value="Personnage">Personnages</option>
                        <option value="Piece">Pièces Lucie</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Type de modification</label>
                    <select class="form-select" @bind="filtreTypeModification">
                        <option value="">Tous</option>
                        <option value="Creation">Création</option>
                        <option value="Modification">Modification</option>
                        <option value="Suppression">Suppression</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date début</label>
                    <input type="date" class="form-control" @bind="dateDebut" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date fin</label>
                    <input type="date" class="form-control" @bind="dateFin" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nom du personnage</label>
                    <input class="form-control" list="listeNoms" @bind="filtreNomEntite" placeholder="Filtrer par nom" />
                    <datalist id="listeNoms">
                        @foreach (var nom in nomsDisponibles)
                        {
                            <option value="@nom"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Champ modifié</label>
                    <select class="form-select" @bind="filtreChampModifie">
                        <option value="">Tous</option>
                        @foreach (var champ in champsDisponibles)
                        {
                            <option value="@champ">@champ</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="ChargerHistorique">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ReinitialiserFiltres">
                        <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                    </button>
                    <button class="btn btn-outline-success btn-sm ms-2" @onclick="ExporterHistorique">
                        <i class="bi bi-download"></i> Exporter (filtré)
                    </button>
                    <button class="btn btn-outline-info btn-sm ms-2" @onclick="ExporterTout">
                        <i class="bi bi-download"></i> Exporter tout
                    </button>
                    <button class="btn btn-outline-warning btn-sm ms-2" @onclick="NettoyerDoublons">
                        <i class="bi bi-eraser"></i> Nettoyer les doublons
                    </button>
                    <button class="btn btn-outline-danger btn-sm ms-2" @onclick="SupprimerTout">
                        <i class="bi bi-trash"></i> Supprimer tout
                    </button>
                    @if (selectedIds.Any())
                    {
                        <button class="btn btn-danger btn-sm ms-2" @onclick="SupprimerSelection">
                            <i class="bi bi-trash"></i> Supprimer la sélection (@selectedIds.Count)
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    @if (historique != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Total</h5>
                        <h2 class="text-primary">@historique.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Créations</h5>
                        <h2 class="text-success">@historique.Count(h => h.TypeModification == TypeModification.Creation)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Modifications</h5>
                        <h2 class="text-warning">@historique.Count(h => h.TypeModification == TypeModification.Modification)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Suppressions</h5>
                        <h2 class="text-danger">@historique.Count(h => h.TypeModification == TypeModification.Suppression)</h2>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Liste de l'historique -->
    <div class="card">
        <div class="card-body">
            @if (chargement)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                </div>
            }
            else if (historique == null || !historique.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Aucune modification enregistrée.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 40px;">
                                    <input type="checkbox" class="form-check-input" 
                                        @onchange="(ChangeEventArgs e) => SelectionnerTout((bool)e.Value!)" 
                                        checked="@(historique.Any() && selectedIds.Count == historique.Count)" />
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.DateInsertion))">
                                    Date Création
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.DateInsertion))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.DateMiseAJour))">
                                    Date Mise à jour
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.DateMiseAJour))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.TypeModification))">
                                    Type
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.TypeModification))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.TypeEntite))">
                                    Entité
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.TypeEntite))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.NomEntite))">
                                    Nom
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.NomEntite))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.ChampModifie))">
                                    Champ
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.ChampModifie))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.AncienneValeur))">
                                    Ancienne valeur
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.AncienneValeur))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.NouvelleValeur))">
                                    Nouvelle valeur
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.NouvelleValeur))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th style="cursor: pointer;" @onclick="() => TrierPar(nameof(HistoriqueModification.Description))">
                                    Description
                                    @if (colonneTriActuelle == nameof(HistoriqueModification.Description))
                                    {
                                        <span class="ms-2">@(ordreTriDescendant ? "▼" : "▲")</span>
                                    }
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var modif in historique)
                            {
                                <tr>
                                    <td style="width: 40px;">
                                        <input type="checkbox" class="form-check-input" 
                                            @onchange="(ChangeEventArgs e) => ToggleSelection(modif.Id, (bool)e.Value!)" 
                                            checked="@selectedIds.Contains(modif.Id)" />
                                    </td>
                                    <td>
                                        <small>@(modif.EstImportation ? modif.DateInsertion.ToLocalTime().ToString("dd/MM/yyyy") : modif.DateInsertion.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</small>
                                    </td>
                                    <td>
                                        <small>@(modif.EstImportation ? modif.DateMiseAJour.ToLocalTime().ToString("dd/MM/yyyy") : modif.DateMiseAJour.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetBadgeClass(modif.TypeModification)">
                                            @GetTypeModificationLabel(modif.TypeModification)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@modif.TypeEntite</span>
                                    </td>
                                    <td><strong>@modif.NomEntite</strong></td>
                                    <td>@modif.ChampModifie</td>
                                    <td><code>@FormatValue(modif.AncienneValeur)</code></td>
                                    <td><code>@FormatValue(modif.NouvelleValeur)</code></td>
                                    <td><small>@modif.Description</small></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => SupprimerLigne(modif.Id)" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<HistoriqueModification>? historique;
    private bool chargement = false;
    
    private string filtreTypeEntite = "";
    private string filtreTypeModification = "";
    private string filtreNomEntite = "";
    private string filtreChampModifie = "";
    private DateTime? dateDebut = DateTime.Today.AddMonths(-1);
    private DateTime? dateFin = DateTime.Today.AddDays(1).AddSeconds(-1);
    
    private string colonneTriActuelle = nameof(HistoriqueModification.DateMiseAJour);
    private bool ordreTriDescendant = true;

    private List<string> nomsDisponibles = new();

    // Import
    private IBrowserFile? fichierImport;
    private byte[]? importBytes;
    private ImportPreviewResult? previewResult;
    private ImportResult? importResult;
    private bool previewComplete;
    private bool importComplete;
    private bool isImporting;
    private bool showConflictResolver;
    private Dictionary<string, bool?> conflictDecisions = new();
    private List<string> champsDisponibles = new();
    private HashSet<string> expandedCollapseSections = new();
    private HashSet<int> selectedIds = new();

    protected override async Task OnInitializedAsync()
    {
        await ChargerHistorique();
    }

    private async Task ChargerHistorique()
    {
        chargement = true;
        try
        {
            TypeEntite? typeEntite = null;
            if (!string.IsNullOrEmpty(filtreTypeEntite))
            {
                typeEntite = Enum.Parse<TypeEntite>(filtreTypeEntite);
            }

            historique = await HistoriqueService.GetHistoriqueAsync(
                typeEntite: typeEntite,
                dateDebut: dateDebut,
                dateFin: dateFin);
            
            // Filtrer par type de modification si nécessaire
            if (!string.IsNullOrEmpty(filtreTypeModification))
            {
                var typeModif = Enum.Parse<TypeModification>(filtreTypeModification);
                historique = historique.Where(h => h.TypeModification == typeModif).ToList();
            }

            // Filtrer par nom d'entité (insensible à la casse)
            if (!string.IsNullOrWhiteSpace(filtreNomEntite))
            {
                var filtreNomLower = filtreNomEntite.Trim().ToLowerInvariant();
                historique = historique
                    .Where(h => !string.IsNullOrEmpty(h.NomEntite) && h.NomEntite.ToLowerInvariant().Contains(filtreNomLower))
                    .ToList();
            }

            // Filtrer par champ modifié
            if (!string.IsNullOrWhiteSpace(filtreChampModifie))
            {
                historique = historique
                    .Where(h => h.ChampModifie == filtreChampModifie)
                    .ToList();
            }

            // Alimenter les listes pour les filtres (datalist et select)
            nomsDisponibles = historique
                .Select(h => h.NomEntite)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!)
                .Distinct()
                .OrderBy(n => n)
                .ToList();

            champsDisponibles = historique
                .Select(h => h.ChampModifie)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();

            // Appliquer le tri par défaut (par date décroissante)
            ApplierTri();
        }
        finally
        {
            chargement = false;
        }
    }

    private void TrierPar(string nomColonne)
    {
        // Si on clique sur la même colonne, inverser l'ordre
        if (colonneTriActuelle == nomColonne)
        {
            ordreTriDescendant = !ordreTriDescendant;
        }
        else
        {
            colonneTriActuelle = nomColonne;
            ordreTriDescendant = true;
        }

        ApplierTri();
    }

    private void ApplierTri()
    {
        if (historique == null)
            return;

        historique = colonneTriActuelle switch
        {
            nameof(HistoriqueModification.DateInsertion) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.DateInsertion).ToList()
                    : historique.OrderBy(h => h.DateInsertion).ToList(),

            nameof(HistoriqueModification.DateMiseAJour) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.DateMiseAJour).ToList()
                    : historique.OrderBy(h => h.DateMiseAJour).ToList(),
            
            nameof(HistoriqueModification.TypeModification) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.TypeModification).ToList()
                    : historique.OrderBy(h => h.TypeModification).ToList(),
            
            nameof(HistoriqueModification.TypeEntite) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.TypeEntite).ToList()
                    : historique.OrderBy(h => h.TypeEntite).ToList(),
            
            nameof(HistoriqueModification.NomEntite) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.NomEntite).ToList()
                    : historique.OrderBy(h => h.NomEntite).ToList(),
            
            nameof(HistoriqueModification.ChampModifie) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.ChampModifie).ToList()
                    : historique.OrderBy(h => h.ChampModifie).ToList(),
            
            nameof(HistoriqueModification.AncienneValeur) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.AncienneValeur).ToList()
                    : historique.OrderBy(h => h.AncienneValeur).ToList(),
            
            nameof(HistoriqueModification.NouvelleValeur) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.NouvelleValeur).ToList()
                    : historique.OrderBy(h => h.NouvelleValeur).ToList(),
            
            nameof(HistoriqueModification.Description) => 
                ordreTriDescendant 
                    ? historique.OrderByDescending(h => h.Description).ToList()
                    : historique.OrderBy(h => h.Description).ToList(),
            
            _ => historique
        };
    }

