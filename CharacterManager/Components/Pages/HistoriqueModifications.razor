    private string FormatValue(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return "-";
        
        // Si la valeur est trop longue, la tronquer
        return value.Length > 50 ? value.Substring(0, 47) + "..." : value;
    }

    // --- Import workflow ---
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        fichierImport = e.File;
        using var ms = new MemoryStream();
        await fichierImport.OpenReadStream().CopyToAsync(ms);
        importBytes = ms.ToArray();
    }

    private async Task HandlePreview()
    {
        if (importBytes == null)
            return;

        isImporting = true;
        previewComplete = false;
        previewResult = null;

        try
        {
            using var stream = new MemoryStream(importBytes);
            previewResult = await HistoriqueService.PreviewImportAsync(stream);
            previewComplete = true;

            if (previewResult.HasConflicts)
            {
                conflictDecisions = previewResult.Conflicts.ToDictionary(c => c.ConflictKey, c => (bool?)null);
            }
        }
        catch (Exception ex)
        {
            previewResult = new ImportPreviewResult
            {
                IsSuccess = false,
                Error = $"Erreur: {ex.Message}"
            };
            previewComplete = true;
        }
        finally
        {
            isImporting = false;
            
            // Initialiser tous les groupes de premier niveau comme expandés
            if (previewResult?.Logs.Any() == true)
            {
                expandedCollapseSections.Clear();
                foreach (var levelGroup in previewResult.Logs.GroupBy(l => l.Level))
                {
                    var levelId = $"level_{levelGroup.Key}";
                    expandedCollapseSections.Add(levelId);
                }
            }
            
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyImport()
    {
        if (importBytes == null)
            return;

        if (HasConflicts && ConflictsUnresolved > 0)
        {
            showConflictResolver = true;
            return;
        }

        isImporting = true;
        importComplete = false;

        try
        {
            using var stream = new MemoryStream(importBytes);
            var resolved = conflictDecisions
                .Where(kv => kv.Value.HasValue)
                .ToDictionary(kv => kv.Key, kv => kv.Value!.Value);

            importResult = await HistoriqueService.ImportAsync(stream, resolved, previewResult?.Conflicts);
            importComplete = true;
            previewComplete = false;
        }
        catch (Exception ex)
        {
            importResult = new ImportResult
            {
                IsSuccess = false,
                Error = $"Erreur: {ex.Message}"
            };
            importComplete = true;
        }
        finally
        {
            isImporting = false;
            await ChargerHistorique();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetImport()
    {
        fichierImport = null;
        importBytes = null;
        previewResult = null;
        importResult = null;
        previewComplete = false;
        importComplete = false;
        conflictDecisions.Clear();
        showConflictResolver = false;
    }

    private bool HasConflicts => previewResult?.HasConflicts == true;
    private int ConflictsTotal => previewResult?.Conflicts.Count ?? 0;
    private int ConflictsResolved => conflictDecisions.Values.Count(v => v.HasValue);
    private int ConflictsUnresolved => ConflictsTotal - ConflictsResolved;
    private bool CanApplyImport => previewComplete && (previewResult?.IsSuccess ?? false) && (!HasConflicts || ConflictsUnresolved == 0);

    private bool IsConflictResolved(string key, bool value) => conflictDecisions.TryGetValue(key, out var val) && val.HasValue && val.Value == value;
    private void SetConflictDecision(string key, bool value) => conflictDecisions[key] = value;
    private void ResolveAllConflicts(bool value)
    {
        var keys = conflictDecisions.Keys.ToList();
        foreach (var key in keys)
        {
            conflictDecisions[key] = value;
        }
    }

