    private void ToggleCollapse(string id)
    {
        if (expandedCollapseSections.Contains(id))
        {
            expandedCollapseSections.Remove(id);
        }
        else
        {
            expandedCollapseSections.Add(id);
        }
    }

    private void ToggleSelection(int id, bool selected)
    {
        if (selected)
        {
            selectedIds.Add(id);
        }
        else
        {
            selectedIds.Remove(id);
        }
    }

    private void SelectionnerTout(bool selected)
    {
        if (selected)
        {
            selectedIds.Clear();
            if (historique != null)
            {
                foreach (var item in historique)
                {
                    selectedIds.Add(item.Id);
                }
            }
        }
        else
        {
            selectedIds.Clear();
        }
    }

    private async Task SupprimerSelection()
    {
        var count = selectedIds.Count;
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer {count} entrée(s) ? Cette action est irréversible.");
        if (!confirm)
            return;

        try
        {
            var idList = selectedIds.ToList();
            int deletedCount = 0;
            
            foreach (var id in idList)
            {
                var success = await HistoriqueService.SupprimerAsync(id);
                if (success)
                    deletedCount++;
            }
            
            selectedIds.Clear();
            await JSRuntime.InvokeVoidAsync("alert", $"{deletedCount} entrée(s) supprimée(s)");
            await ChargerHistorique();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur lors de la suppression: {ex.Message}");
        }
    }
