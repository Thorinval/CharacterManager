@page "/capacites"
@layout CharacterManager.Components.Layout.MainLayout

@using CharacterManager.Server.Models
@using CharacterManager.Server.Services
@using Microsoft.AspNetCore.Components.Forms
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICapaciteService CapaciteService
@inject IPmlExportService PmlExportService
@inject IPmlImportService PmlImportService
@inject IJSRuntime JSRuntime
@inject IClientLocalizationService LocalizationService

<link rel="stylesheet" href="/css/Capacites.css" />

<div class="container-fluid py-4">
    <div class="page-header-banner">
        <h1><i class="bi bi-lightning-charge-fill"></i> @LocalizationService.GetKeyValue("capacities.title")</h1>
    </div>
    <div class="templates-header">
        <div class="header-actions">
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle"></i> @LocalizationService.GetKeyValue("capacities.new")
            </button>
            <button class="btn btn-success" @onclick="ExportCapacites" disabled="@(capacites?.Count == 0)">
                <i class="bi bi-download"></i> @LocalizationService.GetKeyValue("common.export")
            </button>
            <label class="btn btn-info mb-0" for="importCapacitesFile">
                <i class="bi bi-upload"></i> @LocalizationService.GetKeyValue("common.import")
            </label>
            <InputFile id="importCapacitesFile" class="d-none" accept=".pml,.xml" OnChange="HandleImportCapacites" />
        </div>
    </div>
</div>

<div class="page-container">
    @if (capacites == null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>@LocalizationService.GetKeyValue("common.loading")</p>
        </div>
    }
    else if (capacites.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>@LocalizationService.GetKeyValue("capacities.empty")</p>
        </div>
    }
    else
    {
        <div class="capacites-grid hub-grid">
            @foreach (var capacite in capacites)
            {
                <div class="capacite-card hub-card">
                    <div class="card-header hub-card-head">
                        @if (!string.IsNullOrEmpty(capacite.Icon))
                        {
                            <i class="bi bi-@capacite.Icon capacite-icon hub-icon"></i>
                        }
                        else
                        {
                            <i class="bi bi-lightning-charge-fill capacite-icon hub-icon"></i>
                        }
                        <h3>@capacite.Nom</h3>
                    </div>

                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(capacite.Description))
                        {
                            <p class="card-description">@capacite.Description</p>
                        }
                        else
                        {
                            <p class="card-description text-muted">@LocalizationService.GetKeyValue("capacities.noDescription")</p>
                        }
                    </div>

                    <div class="card-actions d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-warning" @onclick="() => OpenEditModal(capacite)">
                            <i class="bi bi-pencil"></i> @LocalizationService.GetKeyValue("common.edit")
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCapacite(capacite.Id)">
                            <i class="bi bi-trash"></i> @LocalizationService.GetKeyValue("common.delete")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick:stopPropagation="true">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? LocalizationService.GetKeyValue("capacities.modal.editTitle") : LocalizationService.GetKeyValue("capacities.modal.createTitle"))</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nomInput" class="form-label">@LocalizationService.GetKeyValue("capacities.fields.nameLabel")</label>
                        <input type="text" class="form-control" id="nomInput" @bind="currentCapacite.Nom"
                            placeholder="@LocalizationService.GetKeyValue("capacities.fields.namePlaceholder")" />
                    </div>
                    <div class="mb-3">
                        <label for="descriptionInput" class="form-label">@LocalizationService.GetKeyValue("capacities.fields.descriptionLabel")</label>
                        <textarea class="form-control" id="descriptionInput" rows="3" @bind="currentCapacite.Description"
                            placeholder="@LocalizationService.GetKeyValue("capacities.fields.descriptionPlaceholder")"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="iconInput" class="form-label">@LocalizationService.GetKeyValue("capacities.fields.iconLabel")</label>
                        <input type="text" class="form-control" id="iconInput" @bind="currentCapacite.Icon"
                            placeholder="@LocalizationService.GetKeyValue("capacities.fields.iconPlaceholder")" />
                        @if (!string.IsNullOrEmpty(currentCapacite.Icon))
                        {
                            <small class="text-muted d-block mt-2">
                                @LocalizationService.GetKeyValue("capacities.preview") <i class="bi bi-@currentCapacite.Icon"></i>
                            </small>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">@LocalizationService.GetKeyValue("common.cancel")</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCapacite"
                        disabled="@string.IsNullOrWhiteSpace(currentCapacite.Nom)">
                        @(isEditing ? LocalizationService.GetKeyValue("common.update") : LocalizationService.GetKeyValue("common.add"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Capacite>? capacites;
    private Capacite currentCapacite = new();
    private bool showModal = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCapacitesAsync();
    }

    private async Task LoadCapacitesAsync()
    {
        try
        {
            capacites = await CapaciteService.GetAllAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{LocalizationService.GetKeyValue("errors.loadingError")}: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        currentCapacite = new();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Capacite capacite)
    {
        currentCapacite = new()
        {
            Id = capacite.Id,
            Nom = capacite.Nom,
            Description = capacite.Description,
            Icon = capacite.Icon
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        currentCapacite = new();
    }

    private async Task SaveCapacite()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(currentCapacite.Nom))
            {
                await JSRuntime.InvokeVoidAsync("alert", LocalizationService.GetKeyValue("errors.capacityNameRequired"));
                return;
            }

            if (isEditing)
            {
                await CapaciteService.UpdateAsync(currentCapacite.Id, currentCapacite);
            }
            else
            {
                await CapaciteService.CreateAsync(currentCapacite);
            }

            CloseModal();
            await LoadCapacitesAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{LocalizationService.GetKeyValue("errors.saveError")}: {ex.Message}");
        }
    }

    private async Task DeleteCapacite(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", LocalizationService.GetKeyValue("capacities.confirmDelete"));
        if (confirmed)
        {
            try
            {
                await CapaciteService.DeleteAsync(id);
                await LoadCapacitesAsync();
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"{LocalizationService.GetKeyValue("errors.deleteError")}: {ex.Message}");
            }
        }
    }

    private async Task ExportCapacites()
    {
        try
        {
            if (capacites?.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", LocalizationService.GetKeyValue("capacities.nothingToExport"));
                return;
            }

            var pmlBytes = await PmlExportService.ExporterCapacitesPmlAsync(capacites ?? new());
            var fileName = $"Capacites_{DateTime.Now:yyyyMMdd_HHmmss}.pml";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(pmlBytes));
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{LocalizationService.GetKeyValue("errors.exportError")}: {ex.Message}");
        }
    }

    private async Task HandleImportCapacites(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var result = await PmlImportService.ImportCapacitesAsync(stream, file.Name);

            if (result.IsSuccess)
            {
                await JSRuntime.InvokeVoidAsync("alert", string.Format(LocalizationService.GetKeyValue("capacities.importSuccessCount"), result.SuccessCount));
                await LoadCapacitesAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Error ?? LocalizationService.GetKeyValue("errors.importError"));
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"{LocalizationService.GetKeyValue("errors.importError")}: {ex.Message}");
        }
    }
}