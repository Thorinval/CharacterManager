@using CharacterManager.Server.Services
@using CharacterManager.Server.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.IO
@using System.Linq
@using System.Collections.Generic
@using CharacterManager.Components
@inject IPmlImportService PmlImportService
@inject IPmlExportService PmlExportService
@inject IJSRuntime JS
@inject IModalService ModalService

<div class="modal-body">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="msr" style="font-size: 2rem; color: #0d6efd;">cloud_upload</span>
        <h4 class="mb-0"><LocalizedText Key="importExportPml.cardTitle" /></h4>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="container-fluid px-0">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        @if (importComplete)
                        {
                            <span></span>
                            <button class="btn btn-outline-light btn-sm" @onclick="Reset">Réinitialiser</button>
                        }
                    </div>
                    <div class="card-body">
                        @if (importComplete)
                        {
                            <div class="alert @(importResult?.IsSuccess == true ? "alert-success" : "alert-danger")" role="alert">
                                @if (importResult?.IsSuccess == true)
                                {
                                    <h4 class="alert-heading">
                                        <LocalizedText Key="importExportPml.success" />
                                    </h4>
                                    <p>@importResult?.SuccessCount <LocalizedText Key="importExportPml.imported" /></p>
                                }
                                else
                                {
                                    <h4 class="alert-heading">
                                        <LocalizedText Key="importExportPml.error" />
                                    </h4>
                                    <p>@importResult?.Error</p>
                                }
                            </div>

                            @if (importResult?.ConflictsApplied.Any() == true)
                            {
                                <div class="border rounded p-3 mb-3" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <span class="msr text-warning" style="font-size: 1.5rem;">task_alt</span>
                                        <h5 class="mb-0">Résolutions de conflits appliquées</h5>
                                    </div>
                                    <div class="alert alert-info mb-3">
                                        <strong>@importResult.ConflictsApplied.Count</strong> conflit(s) résolu(s) :
                                        <strong>@importResult.ConflictsApplied.Count(r => r.Overwritten)</strong> nouvelle(s) valeur(s) appliquée(s),
                                        <strong>@importResult.ConflictsApplied.Count(r => !r.Overwritten)</strong> ancienne(s) valeur(s) conservée(s)
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered table-hover bg-white">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Personnage</th>
                                                    <th>Champ modifié</th>
                                                    <th>Date</th>
                                                    <th>Ancienne valeur</th>
                                                    <th>Nouvelle valeur</th>
                                                    <th class="text-center">Résolution</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var resolution in importResult.ConflictsApplied)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@resolution.PersonnageName</td>
                                                        <td>@resolution.ChampModifie</td>
                                                        <td>@resolution.DateClassement.ToString("dd/MM/yyyy")</td>
                                                        <td class="@(resolution.Overwritten ? "text-muted text-decoration-line-through" : "text-success fw-semibold")">
                                                            @resolution.AncienneValeur
                                                        </td>
                                                        <td class="@(resolution.Overwritten ? "text-success fw-semibold" : "text-muted text-decoration-line-through")">
                                                            @resolution.NouvelleValeur
                                                        </td>
                                                        <td class="text-center">
                                                            @if (resolution.Overwritten)
                                                            {
                                                                <span class="badge bg-success">
                                                                    <span class="msr">check_circle</span> Nouvelle appliquée
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">
                                                                    <span class="msr">history</span> Ancienne conservée
                                                                </span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            @if (importResult?.Logs.Any() == true)
                            {
                                <div class="border rounded p-3 bg-light">
                                    <h5 class="mb-3">Rapport d'import détaillé</h5>
                                    @foreach (var categoryGroup in importResult.Logs.GroupBy(l => l.Category).OrderBy(g => g.Key.ToString()))
                                    {
                                        <div class="mb-2">
                                            <div class="fw-bold text-uppercase small">@GetCategoryLabel(categoryGroup.Key)</div>
                                            @foreach (var dataGroup in categoryGroup.GroupBy(l => l.DataType).OrderBy(g => g.Key))
                                            {
                                                <div class="ms-3 mb-1">
                                                    <div class="fw-semibold">@dataGroup.Key</div>
                                                    <ul class="list-unstyled ms-2 mb-2">
                                                        @foreach (var log in dataGroup)
                                                        {
                                                            <li class="d-flex align-items-center gap-2">
                                                                <span class="badge rounded-pill @GetBadgeClass(log)">@GetBadgeLabel(log)</span>
                                                                <span>@log.Message</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (importResult?.Errors.Count > 0)
                            {
                                <div class="alert alert-warning">
                                    <p class="mb-2"><strong><LocalizedText Key="importExportPml.warnings" /></strong></p>
                                    <ul class="mb-0">
                                        @foreach (var error in importResult.Errors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else if (previewComplete)
                        {
                            <div class="alert alert-info" role="alert">
                                <h4 class="alert-heading">Pré-rapport d'import</h4>
                                <p>@(previewResult?.ValidCount ?? 0) entrées prêtes à être importées.</p>
                                @if (!string.IsNullOrEmpty(previewResult?.Error))
                                {
                                    <p class="text-danger mb-0">@previewResult.Error</p>
                                }
                            </div>

                            @if (previewResult?.Logs.Any() == true)
                            {
                                <div class="border rounded p-3 bg-light mb-3">
                                    <h5 class="mb-3">Rapport détaillé</h5>
                                    @foreach (var categoryGroup in previewResult.Logs.GroupBy(l => l.Category).OrderBy(g => g.Key.ToString()))
                                    {
                                        <div class="mb-2">
                                            <div class="fw-bold text-uppercase small">@GetCategoryLabel(categoryGroup.Key)</div>
                                            @foreach (var dataGroup in categoryGroup.GroupBy(l => l.DataType).OrderBy(g => g.Key))
                                            {
                                                <div class="ms-3 mb-1">
                                                    <div class="fw-semibold">@dataGroup.Key</div>
                                                    <ul class="list-unstyled ms-2 mb-2">
                                                        @foreach (var log in dataGroup)
                                                        {
                                                            <li class="d-flex align-items-center gap-2">
                                                                <span class="badge rounded-pill @GetBadgeClass(log)">@GetBadgeLabel(log)</span>
                                                                <span>@log.Message</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (HasConflicts)
                            {
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <button class="btn btn-warning" @onclick="() => showConflictResolver = true">
                                        Résoudre les conflits (@ConflictsTotal)
                                    </button>
                                    <span class="text-muted">Conflits non résolus: @ConflictsUnresolved / @ConflictsTotal</span>
                                </div>
                            }

                            <div class="d-flex gap-2">
                                <button class="btn btn-success" @onclick="ApplyImport" disabled="@(!CanApplyImport)">
                                    Accepter l'intégration
                                </button>
                                <button class="btn btn-secondary" @onclick="ResetPreview">Annuler</button>
                            </div>

                            @if (showConflictResolver && HasConflicts)
                            {
                                <div class="card mt-3">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div>Résolution des conflits (@ConflictsUnresolved non résolus / @ConflictsResolved résolus)</div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => ResolveAllConflicts(true)">Tout valider</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ResolveAllConflicts(false)">Tout refuser</button>
                                        </div>
                                    </div>
                                    <div class="card-body" style="max-height: 320px; overflow:auto;">
                                        @foreach (var conflict in previewResult!.Conflicts)
                                        {
                                            <div class="border-bottom pb-2 mb-2">
                                                <div class="fw-semibold">@conflict.PersonnageName (@conflict.ChampModifie) - @conflict.DateClassement</div>
                                                <div class="text-muted small">Ancienne: @conflict.AncienneValeur | Nouvelle: @conflict.NouvelleValeur</div>
                                                <div class="mt-1 d-flex gap-3">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="@($"c_{conflict.ConflictKey}")" value="overwrite" checked="@(IsConflictResolved(conflict.ConflictKey, true))" @onchange="_ => SetConflictDecision(conflict.ConflictKey, true)">
                                                        <label class="form-check-label">Accepter la nouvelle valeur</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="@($"c_{conflict.ConflictKey}")" value="keep" checked="@(IsConflictResolved(conflict.ConflictKey, false))" @onchange="_ => SetConflictDecision(conflict.ConflictKey, false)">
                                                        <label class="form-check-label">Conserver l'existant</label>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="card-footer d-flex justify-content-end gap-2">
                                        <button class="btn btn-secondary" @onclick="() => showConflictResolver = false">Annuler</button>
                                        <button class="btn btn-primary" disabled="@(ConflictsUnresolved > 0)" @onclick="() => showConflictResolver = false">OK</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <ul class="nav nav-tabs mb-3" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link @(activeTab == "import" ? "active" : "")" @onclick='() => activeTab = "import"'>
                                        <i class="bi bi-upload"></i>
                                        <LocalizedText Key="importExportPml.import" />
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(activeTab == "export" ? "active" : "")" @onclick='() => activeTab = "export"'>
                                        <i class="bi bi-download"></i>
                                        <LocalizedText Key="importExportPml.export" />
                                    </button>
                                </li>
                            </ul>

                            @if (activeTab == "import")
                            {
                                <form @onsubmit="HandlePreview">
                                    @if (!string.IsNullOrEmpty(lastImportedFileName))
                                    {
                                        <div class="alert alert-secondary">
                                            <strong><LocalizedText Key="importExportPml.lastFile" /></strong> @lastImportedFileName
                                            <small class="d-block text-muted mt-1"><LocalizedText Key="importExportPml.selectInfo" /></small>
                                        </div>
                                    }

                                    <div class="mb-3">
                                        <label class="form-label fw-bold"><LocalizedText Key="importExportPml.selectTypes" /></label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="importInventory" id="importInventory">
                                            <label class="form-check-label" for="importInventory"><LocalizedText Key="importExportPml.inventory" /></label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="importTemplates" id="importTemplates">
                                            <label class="form-check-label" for="importTemplates"><LocalizedText Key="importExportPml.templates" /></label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="importBestSquad" id="importBestSquad">
                                            <label class="form-check-label" for="importBestSquad"><LocalizedText Key="importExportPml.bestSquad" /></label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="importHistories" id="importHistories">
                                            <label class="form-check-label" for="importHistories"><LocalizedText Key="importExportPml.rankings" /></label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="importLeagueHistory" id="importLeagueHistory">
                                            <label class="form-check-label" for="importLeagueHistory"><LocalizedText Key="importExportPml.leagueHistory" /></label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="importCapacites" id="importCapacites">
                                            <label class="form-check-label" for="importCapacites">Capacités</label>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="pmlFile" class="form-label"><LocalizedText Key="importExportPml.selectFile" /></label>
                                        <InputFile class="form-control" id="pmlFile" accept=".pml,.xml" OnChange="OnFileSelected" disabled="@isImporting" />
                                        <small class="text-muted"><LocalizedText Key="importExportPml.expectedFormat" /></small>
                                    </div>

                                    <div class="mb-3">
                                        <p class="text-info"><strong><LocalizedText Key="importExportPml.infoTitle" /></strong></p>
                                        <ul>
                                            <li><LocalizedText Key="importExportPml.infoInventaire" /></li>
                                            <li><LocalizedText Key="importExportPml.infoTemplate" /></li>
                                            <li><LocalizedText Key="importExportPml.infoFormat" /></li>
                                        </ul>
                                    </div>

                                    @if (selectedFileName != null)
                                    {
                                        <div class="alert alert-info">
                                            <LocalizedText Key="importExportPml.selectedFile" /> <strong>@selectedFileName</strong>
                                        </div>
                                    }

                                    <button type="submit" class="btn btn-success" disabled="@(uploadedBytes == null || isImporting || !HasSelectedImportTypes())">
                                        @if (isImporting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        }
                                        Prévisualiser l'import
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold"><LocalizedText Key="importExportPml.selectTypes" /></label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="exportInventory" id="exportInventory">
                                        <label class="form-check-label" for="exportInventory"><LocalizedText Key="importExportPml.inventory" /></label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="exportTemplates" id="exportTemplates">
                                        <label class="form-check-label" for="exportTemplates"><LocalizedText Key="importExportPml.templates" /></label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="exportBestSquad" id="exportBestSquad">
                                        <label class="form-check-label" for="exportBestSquad"><LocalizedText Key="importExportPml.bestSquad" /></label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="exportHistories" id="exportHistories">
                                        <label class="form-check-label" for="exportHistories"><LocalizedText Key="importExportPml.rankings" /></label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="exportLeagueHistory" id="exportLeagueHistory">
                                        <label class="form-check-label" for="exportLeagueHistory"><LocalizedText Key="importExportPml.leagueHistory" /></label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="exportCapacites" id="exportCapacites">
                                        <label class="form-check-label" for="exportCapacites">Capacités</label>
                                    </div>
                                </div>

                                <button class="btn btn-primary" @onclick="HandleExport" disabled="@(!HasSelectedExportTypes())">
                                    <i class="bi bi-download"></i>
                                    <LocalizedText Key="importExportPml.exportButton" />
                                </button>
                                <button class="btn btn-secondary ms-2" @onclick="ExportAsConfigPml" disabled="@(!HasSelectedExportTypes())">
                                    <i class="bi bi-save"></i> Exporter comme config.pml (serveur)
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning mb-0">
                <LocalizedText Key="importExportPml.accessDenied" />
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private byte[]? uploadedBytes;
    private bool isImporting = false;
    private bool importComplete = false;
    private bool previewComplete = false;
    private bool showConflictResolver = false;
    private ImportResult? importResult;
    private ImportPreviewResult? previewResult;
    private string? lastImportedFileName;
    private string activeTab = "import";
    private PmlExportOptions exportOptions = new();
    private Dictionary<string, bool?> conflictDecisions = new();

    // Import checkboxes
    private bool importInventory
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_INVENTORY);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_INVENTORY); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_INVENTORY); }
    }
    private bool importTemplates
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_TEMPLATES);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_TEMPLATES); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_TEMPLATES); }
    }
    private bool importBestSquad
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD); }
    }
    private bool importHistories
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_HISTORIES);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_HISTORIES); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_HISTORIES); }
    }
    private bool importLeagueHistory
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY); }
    }
    private bool importCapacites
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_CAPACITES);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_CAPACITES); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_CAPACITES); }
    }

    // Export checkboxes
    private bool exportInventory
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_INVENTORY);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_INVENTORY); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_INVENTORY); }
    }
    private bool exportTemplates
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_TEMPLATES);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_TEMPLATES); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_TEMPLATES); }
    }
    private bool exportBestSquad
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD); }
    }
    private bool exportHistories
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_HISTORIES);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_HISTORIES); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_HISTORIES); }
    }
    private bool exportLeagueHistory
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY); }
    }
    private bool exportCapacites
    {
        get => exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_CAPACITES);
        set { if (value) exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_CAPACITES); else exportOptions.RemoveExportType(PmlExportOptions.EXPORT_TYPE_CAPACITES); }
    }

    protected override async Task OnInitializedAsync()
    {
        exportOptions.AddExportType(PmlExportOptions.EXPORT_TYPE_INVENTORY);
        lastImportedFileName = await PmlImportService.GetLastImportedFileName();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;

        using var ms = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
        uploadedBytes = ms.ToArray();
        previewComplete = false;
        importComplete = false;
        previewResult = null;
        conflictDecisions.Clear();
    }

    private bool HasSelectedImportTypes() => exportOptions.HasSelectedExports();
    private bool HasSelectedExportTypes() => exportOptions.HasSelectedExports();

    private async Task HandlePreview()
    {
        if (uploadedBytes == null || !HasSelectedImportTypes())
        {
            return;
        }

        isImporting = true;
        importComplete = false;
        previewComplete = false;
        previewResult = null;
        conflictDecisions.Clear();

        try
        {
            using var stream = new MemoryStream(uploadedBytes);
            previewResult = await PmlImportService.PreviewPmlClassementsAsync(stream);
            previewComplete = true;

            if (previewResult.HasConflicts)
            {
                conflictDecisions = previewResult.Conflicts.ToDictionary(c => c.ConflictKey, c => (bool?)null);
            }
        }
        catch (Exception ex)
        {
            previewResult = new ImportPreviewResult
            {
                IsSuccess = false,
                Error = $"Erreur: {ex.Message}"
            };
            previewComplete = true;
        }
        finally
        {
            isImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyImport()
    {
        if (uploadedBytes == null || !HasSelectedImportTypes())
        {
            return;
        }

        if (HasConflicts && ConflictsUnresolved > 0)
        {
            showConflictResolver = true;
            return;
        }

        isImporting = true;
        importComplete = false;

        try
        {
            using var stream = new MemoryStream(uploadedBytes);

            if (HasConflicts)
            {
                var resolved = conflictDecisions
                    .Where(kv => kv.Value.HasValue)
                    .ToDictionary(kv => kv.Key, kv => kv.Value!.Value);

                importResult = await PmlImportService.ImportPmlWithConflictResolution(
                    stream,
                    selectedFileName ?? "",
                    resolved,
                    previewResult?.Conflicts
                );
            }
            else
            {
                importResult = await PmlImportService.ImportPmlAsync(
                    stream,
                    selectedFileName ?? "",
                    exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_INVENTORY),
                    exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_TEMPLATES),
                    exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_BEST_SQUAD),
                    exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_HISTORIES),
                    exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_LEAGUE_HISTORY)
                );
            }

            if (exportOptions.IsExporting(PmlExportOptions.EXPORT_TYPE_CAPACITES) && importResult?.IsSuccess == true)
            {
                using var capacitesStream = new MemoryStream(uploadedBytes);
                var capacitesResult = await PmlImportService.ImportCapacitesAsync(capacitesStream, selectedFileName ?? "");
                if (capacitesResult.IsSuccess)
                {
                    importResult.SuccessCount += capacitesResult.SuccessCount;
                    importResult.Errors.AddRange(capacitesResult.Errors);
                }
                else if (!capacitesResult.IsSuccess && !capacitesResult.Error?.Contains("Aucune section") == true)
                {
                    importResult.Errors.Add(capacitesResult.Error ?? "Erreur lors de l'import des capacités");
                }
            }

            importComplete = true;
            previewComplete = false;
            lastImportedFileName = await PmlImportService.GetLastImportedFileName();
        }
        catch (Exception ex)
        {
            importResult = new ImportResult
            {
                IsSuccess = false,
                Error = $"Erreur: {ex.Message}"
            };
            importComplete = true;
        }
        finally
        {
            isImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool HasConflicts => previewResult?.HasConflicts == true;
    private int ConflictsTotal => previewResult?.Conflicts.Count ?? 0;
    private int ConflictsResolved => conflictDecisions.Values.Count(v => v.HasValue);
    private int ConflictsUnresolved => ConflictsTotal - ConflictsResolved;
    private bool CanApplyImport => previewComplete && (previewResult?.IsSuccess ?? false) && (!HasConflicts || ConflictsUnresolved == 0);

    private bool IsConflictResolved(string key, bool value) => conflictDecisions.TryGetValue(key, out var val) && val.HasValue && val.Value == value;
    private void SetConflictDecision(string key, bool value)
    {
        conflictDecisions[key] = value;
    }

    private void ResolveAllConflicts(bool value)
    {
        var keys = conflictDecisions.Keys.ToList();
        foreach (var key in keys)
        {
            conflictDecisions[key] = value;
        }
    }

    private void ResetPreview()
    {
        previewComplete = false;
        previewResult = null;
        conflictDecisions.Clear();
        showConflictResolver = false;
    }

    private async Task HandleExport()
    {
        if (!HasSelectedExportTypes())
        {
            return;
        }

        await HandleExportInternal(downloadToClient: true);
    }

    private async Task HandleExportInternal(bool downloadToClient)
    {
        try
        {
            var exportData = await PmlExportService.ExportPmlAsync(exportOptions);
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            var fileName = $"export_{timestamp}.pml";

            if (downloadToClient)
            {
                importResult = new ImportResult
                {
                    IsSuccess = true,
                    SuccessCount = 1,
                    Error = $"Export réussi: {fileName} ({exportData.Length} bytes)"
                };
                importComplete = true;
                await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(exportData));
            }
        }
        catch (Exception ex)
        {
            importResult = new ImportResult
            {
                IsSuccess = false,
                Error = $"Erreur: {ex.Message}"
            };
            importComplete = true;
        }
    }

    private static string GetBadgeClass(ImportLogEntry entry) => entry.Level switch
    {
        ImportLogLevel.Error => "bg-danger text-white",
        ImportLogLevel.Warning => "bg-warning text-dark",
        _ => "bg-success text-white"
    };

    private static string GetBadgeLabel(ImportLogEntry entry) => entry.Level switch
    {
        ImportLogLevel.Error => "ERREUR",
        ImportLogLevel.Warning => "Warning",
        _ => "Ok"
    };

    private static string GetCategoryLabel(ImportLogCategory category) => category switch
    {
        ImportLogCategory.Classement => "Classement",
        ImportLogCategory.Commandant => "Commandant",
        ImportLogCategory.Mercenaires => "Mercenaires",
        ImportLogCategory.Androides => "Androides",
        ImportLogCategory.Lucie => "Lucie",
        ImportLogCategory.Capacites => "Capacités",
        _ => "Général"
    };

    private void Reset()
    {
        selectedFile = null;
        selectedFileName = null;
        uploadedBytes = null;
        importComplete = false;
        previewComplete = false;
        previewResult = null;
        importResult = null;
        conflictDecisions.Clear();
        showConflictResolver = false;
        activeTab = "import";
    }

    private async Task ExportAsConfigPml()
    {
        try
        {
            var exportData = await PmlExportService.ExportPmlAsync(exportOptions);
            var configPath = Path.Combine("wwwroot", "config.pml");
            await File.WriteAllBytesAsync(configPath, exportData);

            importResult = new ImportResult
            {
                IsSuccess = true,
                SuccessCount = 1,
                Error = $"Export serveur réussi : {configPath} ({exportData.Length} bytes)"
            };
            importComplete = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            importResult = new ImportResult
            {
                IsSuccess = false,
                Error = $"Erreur export serveur : {ex.Message}"
            };
            importComplete = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Close()
    {
        ModalService.Close();
    }
}
